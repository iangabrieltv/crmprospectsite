# === Backend (exclusivo do servidor / Vercel Env Vars) ===
GEMINI_API_KEY=
# Opcional: trava o backend para aceitar apenas o UID/e-mail do administrador único
FIREBASE_PROJECT_ID=
AUTHORIZED_ADMIN_UID=
AUTHORIZED_ADMIN_EMAIL=
# Opcional: caminho para Service Account somente-leitura ao rodar `npm run backup:firestore` localmente
GOOGLE_APPLICATION_CREDENTIALS=

# === Frontend (opcionais — sobrescrevem o config padrão apenas para ambiente de staging/testes) ===
VITE_APP_ENV=production
VITE_WORKSPACE_ID=adm_equipeie
VITE_AUTHORIZED_ADMIN_UID=
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=