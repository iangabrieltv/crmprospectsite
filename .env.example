# === Backend (exclusivo do servidor / Vercel Env Vars) ===
# Obrigatórios para liberação das rotas /api/gemini/* (sem fallback permissivo):
FIREBASE_PROJECT_ID=
AUTHORIZED_ADMIN_UID=
# Opcional como camada adicional além do UID (nunca substitui AUTHORIZED_ADMIN_UID):
AUTHORIZED_ADMIN_EMAIL=
# Chave da Gemini API (apenas servidor — nunca exposta no frontend):
GEMINI_API_KEY=
# Obrigatório ao executar `npm run backup:firestore` localmente (Service Account somente-leitura):
GOOGLE_APPLICATION_CREDENTIALS=

# === Frontend (obrigatórios/opcionais de ambiente Vite) ===
# OBRIGATÓRIO: UID exato do administrador único (sem ele o login é bloqueado):
VITE_AUTHORIZED_ADMIN_UID=
# Workspace padrão preservado:
VITE_WORKSPACE_ID=adm_equipeie
# Ambiente: production | staging | development
VITE_APP_ENV=development
# Ativar emuladores locais (true somente em testes/dev local):
VITE_USE_FIREBASE_EMULATOR=false

# === Overrides opcionais de Firebase para ambiente Staging / Preview ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# === Testes de Regras no Emulator ===
# Opcional: sobrescreve o banco nomeado em tests contra Emulator (padrão lê firebase-applet-config.json)
TEST_FIRESTORE_DATABASE_ID=