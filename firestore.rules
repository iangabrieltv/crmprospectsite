rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      allow read, write: if workspaceId in ['adm_equipeie', 'kaizenvisual123'];

      match /{allChildren=**} {
        allow read, write: if workspaceId in ['adm_equipeie', 'kaizenvisual123'];
      }
    }
  }
}
