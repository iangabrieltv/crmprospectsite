rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Rede de segurança global: nega qualquer leitura ou escrita fora das rotas permitidas
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HELPERS DE AUTENTICAÇÃO E AUTORIZAÇÃO (USUÁRIO ÚNICO PRIVADO - IAN)
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    // IMPORTANTE: O Firestore Rules não lê variáveis de ambiente em tempo de execução.
    // Substitua 'REPLACE_WITH_YOUR_FIREBASE_UID' pelo seu UID real do Firebase Auth
    // (ou execute `AUTHORIZED_ADMIN_UID=<seu_uid> npm run rules:configure -- --write`)
    // ANTES de publicar no console ou via `firebase deploy --only firestore:rules`.
    // Enquanto o placeholder permanecer presente, TODAS as operações são bloqueadas.
    function authorizedAdminUid() {
      return 'REPLACE_WITH_YOUR_FIREBASE_UID';
    }

    function hasValidAdminUidConfig() {
      return authorizedAdminUid() is string
        && authorizedAdminUid().size() >= 6
        && authorizedAdminUid().size() <= 128
        && authorizedAdminUid() != 'REPLACE_WITH_YOUR_FIREBASE_UID';
    }

    function isAuthorizedAdmin() {
      return isSignedIn()
        && hasValidAdminUidConfig()
        && request.auth.uid == authorizedAdminUid();
    }

    // -------------------------------------------------------------------------
    // HELPERS DE INTEGRIDADE DE SCHEMA & ANTI-CORRUPÇÃO
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || (data[field] is int || data[field] is float);
    }

    function isValidLead(data) {
      return data.keys().hasAll(['companyName', 'phone', 'stage'])
        && data.keys().hasOnly([
          'id', 'nicheId', 'companyName', 'contactName', 'phone', 'displayPhone',
          'address', 'city', 'category', 'googleRating', 'googleReviewsCount',
          'googleMapsUrl', 'websiteUrl', 'mockupUrl', 'stage', 'scriptUsed',
          'creationValue', 'monthlyMrr', 'lastContactDate', 'notes', 'objection',
          'createdAt', 'aiPitch', 'opportunityAngle',
          'meetingDate', 'meetingTime', 'meetingNotes', 'meetingLink', 'meetingStatus',
          'callbackDate', 'callbackTime', 'callbackNotes', 'callbackStatus',
          'schemaVersion', 'updatedAt'
        ])
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 300
        && data.phone is string && data.phone.size() <= 40
        && data.stage is string && data.stage.size() >= 1 && data.stage.size() <= 60
        && isOptionalString(data, 'id', 128)
        && isOptionalString(data, 'nicheId', 128)
        && isOptionalString(data, 'contactName', 200)
        && isOptionalString(data, 'displayPhone', 50)
        && isOptionalString(data, 'address', 500)
        && isOptionalString(data, 'city', 150)
        && isOptionalString(data, 'category', 150)
        && isOptionalString(data, 'googleMapsUrl', 1000)
        && isOptionalString(data, 'websiteUrl', 1000)
        && isOptionalString(data, 'mockupUrl', 1000)
        && isOptionalString(data, 'scriptUsed', 100)
        && isOptionalString(data, 'lastContactDate', 64)
        && isOptionalString(data, 'objection', 1000)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'aiPitch', 4000)
        && isOptionalString(data, 'opportunityAngle', 500)
        && isOptionalString(data, 'meetingDate', 32)
        && isOptionalString(data, 'meetingTime', 16)
        && isOptionalString(data, 'meetingNotes', 4000)
        && isOptionalString(data, 'meetingLink', 1000)
        && isOptionalString(data, 'meetingStatus', 32)
        && isOptionalString(data, 'callbackDate', 32)
        && isOptionalString(data, 'callbackTime', 16)
        && isOptionalString(data, 'callbackNotes', 1000)
        && isOptionalString(data, 'callbackStatus', 32)
        && isOptionalString(data, 'updatedAt', 64)
        && isOptionalNumber(data, 'googleRating')
        && isOptionalNumber(data, 'googleReviewsCount')
        && isOptionalNumber(data, 'creationValue')
        && isOptionalNumber(data, 'monthlyMrr')
        && isOptionalNumber(data, 'schemaVersion')
        && (!( 'notes' in data ) || (data.notes is list && data.notes.size() <= 500 && (data.notes.size() == 0 || data.notes[0] is map)));
    }

    function isValidNiche(data) {
      return data.keys().hasAll(['name', 'segment', 'city'])
        && data.keys().hasOnly([
          'id', 'name', 'segment', 'city', 'targetCities', 'emoji',
          'targetMrr', 'createdAt', 'scripts', 'schemaVersion', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.segment is string && data.segment.size() <= 200
        && data.city is string && data.city.size() <= 150
        && isOptionalString(data, 'id', 128)
        && isOptionalString(data, 'emoji', 32)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64)
        && isOptionalNumber(data, 'targetMrr')
        && isOptionalNumber(data, 'schemaVersion')
        && (!( 'targetCities' in data ) || (data.targetCities is list && data.targetCities.size() <= 200 && (data.targetCities.size() == 0 || data.targetCities[0] is string)))
        && (!( 'scripts' in data ) || data.scripts is map);
    }

    function isValidImportedSheet(data) {
      return data.keys().hasAll(['name', 'nicheId', 'totalLeads'])
        && data.keys().hasOnly([
          'id', 'name', 'nicheId', 'nicheName', 'importedAt',
          'totalLeads', 'format', 'size', 'leadsSummary',
          'schemaVersion', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 300
        && data.nicheId is string && data.nicheId.size() >= 1 && data.nicheId.size() <= 128
        && (data.totalLeads is int || data.totalLeads is float) && data.totalLeads >= 0
        && isOptionalString(data, 'id', 128)
        && isOptionalString(data, 'nicheName', 200)
        && isOptionalString(data, 'importedAt', 64)
        && isOptionalString(data, 'format', 64)
        && isOptionalString(data, 'updatedAt', 64)
        && isOptionalNumber(data, 'size')
        && isOptionalNumber(data, 'schemaVersion')
        && (!( 'leadsSummary' in data ) || (data.leadsSummary is list && data.leadsSummary.size() <= 20 && (data.leadsSummary.size() == 0 || data.leadsSummary[0] is map)));
    }

    // -------------------------------------------------------------------------
    // WORKSPACE PRIVADO DO ADMINISTRADOR ÚNICO (PRESERVA CAMINHO DE PRODUÇÃO)
    // -------------------------------------------------------------------------
    match /workspaces/{workspaceId} {
      // Nega listagem de workspaces e bloqueia criação/alteração de metadados na raiz pelo cliente
      allow get: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin();
      allow list, create, update, delete: if false;

      match /leads/{leadId} {
        allow list: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin();
        allow get, delete: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin() && isValidId(leadId);
        allow create, update: if workspaceId == 'adm_equipeie'
          && isAuthorizedAdmin()
          && isValidId(leadId)
          && isValidLead(incoming());
      }

      match /niches/{nicheId} {
        allow list: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin();
        allow get, delete: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin() && isValidId(nicheId);
        allow create, update: if workspaceId == 'adm_equipeie'
          && isAuthorizedAdmin()
          && isValidId(nicheId)
          && isValidNiche(incoming());
      }

      match /importedSheets/{sheetId} {
        allow list: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin();
        allow get, delete: if workspaceId == 'adm_equipeie' && isAuthorizedAdmin() && isValidId(sheetId);
        allow create, update: if workspaceId == 'adm_equipeie'
          && isAuthorizedAdmin()
          && isValidId(sheetId)
          && isValidImportedSheet(incoming());
      }
    }
  }
}
