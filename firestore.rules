rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      allow read, write: if workspaceId == 'adm_equipeie';

      match /{allChildren=**} {
        allow read, write: if workspaceId == 'adm_equipeie';
      }
    }
  }
}
